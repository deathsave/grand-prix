# Stable names for the pinball serial boards.
#
# ID_MM_DEVICE_IGNORE stops ModemManager from probing these ports with AT
# commands at boot, which can leave the boards in a bad state so MPF can't
# talk to them. TAG+="systemd" creates dev-tty*.device units so the
# grand-prix service can wait for the ports to exist before starting MPF.

# OPP Chain 1 - Cypress USB-Serial bridge (shares its ID with the cytherm
# thermometer driver, see blacklist-cytherm.conf)
SUBSYSTEM=="tty", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="0002", SYMLINK+="ttyOPP0", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="systemd"

# OPP Chain 2 - Cobrapin (STMicro Virtual COM Port)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="ttyOPP1", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="systemd"

# My Pinballs Segment Displays - Arduino Uno
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", SYMLINK+="ttyMYPB", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="systemd"
